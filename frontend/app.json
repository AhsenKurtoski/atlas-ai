{
  "expo": {
    "name": "ATLAS AI",
    "slug": "atlas-ai",
    "version": "3.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "atlasai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlasai.family",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ATLAS usa il microfono per dettare i messaggi in chat.",
        "NSPhotoLibraryUsageDescription": "ATLAS usa la galleria per inviare foto alla chat AI.",
        "NSLocalNetworkUsageDescription": "ATLAS si connette al backend sulla rete locale per chat, foto e integrazioni.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.atlasai.family",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7c3aed",
          "defaultChannel": "atlas_default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ATLAS usa la galleria per inviare foto alla chat AI."
        }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ],
      "expo-asset"
    ]
  },
  "version": "3.4.0"
}
