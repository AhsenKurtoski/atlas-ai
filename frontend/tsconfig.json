{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "shims.d.ts",
    "nativewind-env.d.ts",
    "App.tsx",
    "app.config.ts",
    "app.config.js",
    "babel.config.js",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web-build"
  ]
}
