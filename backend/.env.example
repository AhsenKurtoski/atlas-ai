# ==========================================================
#  ATLAS AI v3.0 — variabili d'ambiente backend
#  Copia questo file in `backend/.env` e compila solo ciò che ti serve.
#  TUTTE le variabili sono opzionali: senza di esse l'app parte in
#  modalità locale (JSON in backend/_local_db) e senza LLM.
# ==========================================================

# --- Applicazione ---
# In produzione i PIN demo sono rifiutati e, se profiles.json manca o è
# corrotto, nessun profilo viene caricato (fail closed): imposta i PIN reali.
APP_ENV=development              # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# Durata sessione (ore) dei token PIN
TOKEN_TTL_HOURS=8
# Segreto per firmare i token. Se vuoto viene generato in backend/_local_db/.atlas_secret
# ATLAS_SECRET_KEY=cambia-questo-valore-in-produzione

# --- CORS (solo per la preview web; l'app mobile non usa CORS) ---
# In produzione senza questa variabile il CORS è CHIUSO (nessuna origine web).
# Elenca le origini esatte, separate da virgola, senza slash finale.
# CORS_ALLOWED_ORIGINS=https://atlas.miodominio.it,http://localhost:19007

# --- Backup automatico del database locale (_local_db) ---
# Creato all'avvio e ogni 6 ore in backend/_backups (ultimi 14 archivi).
# Ripristino: scompatta lo zip scelto dentro backend/_local_db.

# --- Database (vuoto = modalità locale su file JSON) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=service-role-key   (alias: SUPABASE_SERVICE_ROLE_KEY)

# --- Google Gemini (gratuito con piano Free; fino a 3 chiavi in rotazione) ---
# GOOGLE_API_KEY_1=
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Notifiche push ---
# Le notifiche usano il servizio Expo Push (gratuito, nessuna chiave).
# Firebase è opzionale, solo per token FCM/APNs nativi:
# FIREBASE_CREDENTIALS=./firebase-credentials.json
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# --- Gmail + Google Calendar (OAuth gratuito) ---
# 1) https://console.cloud.google.com/apis/credentials → OAuth client (Web)
# 2) abilita Gmail API e Google Calendar API
# 3) aggiungi come redirect URI: http://localhost:8010/integrazioni/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8010/integrazioni/google/callback
# APP_DEEPLINK=atlasai://oauth

# --- Server MCP (Model Context Protocol) ---
# JSON: {"nome": {"url": "http://host:porta/mcp", "headers": {"Authorization": "Bearer ..."}}}
# MCP_SERVERS={"files":{"url":"http://127.0.0.1:9000/mcp"}}

# --- Servizi opzionali (tutti hanno fallback gratuiti) ---
# GITHUB_TOKEN=ghp_...            (innalza il rate limit GitHub)
# NEWSAPI_KEY=                    (se assente si usa Google News RSS)
# ALPHA_VANTAGE_KEY=              (se assente si usa Yahoo Finance)
# AMADEUS_CLIENT_ID=              (piano gratuito Amadeus per i voli)
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test                # test | production

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Rome

# Sicurezza rete: consenti fetch verso IP privati/locali (default false)
ALLOW_PRIVATE_FETCH=false

# Città usata dalle automazioni meteo (briefing e ombrello smart)
ATLAS_CITY=Milano

# --- Agente browser (Chromium headless) ---
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
# Durata sessione browser per profilo (secondi)
BROWSER_SESSION_TTL=900
# Cache DNS del route guard (secondi; 0 disabilita la cache)
BROWSER_DNS_CACHE_TTL=60
# Turni massimi di function calling per una risposta (browser multi-step)
AGENT_MAX_TOOL_TURNS=10
# Timeout navigazione/azione Playwright (millisecondi)
BROWSER_NAV_TIMEOUT_MS=25000
BROWSER_ACTION_TIMEOUT_MS=8000
# In container senza sandbox (solo se necessario)
BROWSER_NO_SANDBOX=false
